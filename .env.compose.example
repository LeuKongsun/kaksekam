# Copy this file to .env on the deployment server and replace every example
# value. Never commit the resulting .env file.

# Use the Compose service name `postgres` when running the bundled database.
DATABASE_URL=postgres://kaksekam:kaksekam@postgres:5432/kaksekam
REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-different-long-random-secret

STORE_CORS=https://store.example.com
ADMIN_CORS=https://admin.example.com
AUTH_CORS=https://store.example.com,https://admin.example.com

# Host port mapped to the API container. A reverse proxy can target this port.
BACKEND_PORT=9000
