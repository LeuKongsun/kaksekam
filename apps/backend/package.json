{
  "name": "@kaksekam/backend",
  "version": "0.0.1",
  "description": "Kaksekam agriculture marketplace backend.",
  "author": "Kaksekam",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "marketplace",
    "headless",
    "kaksekam"
  ],
  "scripts": {
    "build": "medusa build",
    "build:admin": "medusa build --admin-only",
    "start": "medusa start",
    "dev": "medusa develop",
    "seed": "medusa exec ./src/migration-scripts/initial-data-seed.ts && medusa exec ./src/migration-scripts/marketplace-data-cleanup.ts && medusa exec ./src/migration-scripts/marketplace-demo-data.ts && medusa exec ./src/migration-scripts/marketplace-demo-listing-status.ts",
    "seed:marketplace-links": "medusa exec ./src/migration-scripts/marketplace-data-cleanup.ts && medusa exec ./src/migration-scripts/marketplace-demo-data.ts && medusa exec ./src/migration-scripts/marketplace-demo-listing-status.ts",
    "seed:launch": "medusa exec ./src/migration-scripts/marketplace-launch-data.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.15.3",
    "@medusajs/admin-shared": "2.15.3",
    "@medusajs/caching": "2.15.3",
    "@medusajs/cli": "2.15.3",
    "@medusajs/dashboard": "2.15.3",
    "@medusajs/draft-order": "2.15.3",
    "@medusajs/framework": "2.15.3",
    "@medusajs/medusa": "2.15.3",
    "@tanstack/react-query": "5.64.2",
    "react-router-dom": "6.30.3",
    "react-i18next": "13.5.0",
    "@medusajs/ui": "4.1.13",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.15.3",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1"
}
